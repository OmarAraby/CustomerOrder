<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <!--
    DESIGN-TIME ONLY.
    At runtime the connection string comes from CustomerOrder.Api\Web.config.
    This copy exists so EF6 migration commands (Enable-Migrations / Add-Migration /
    Update-Database) can find the database even when the startup project is not
    resolved correctly by the Package Manager Console. Keep the two in sync.

    The name below MUST match what AppDbContext passes to its base constructor:
        public AppDbContext() : base("name=CustomerOrderDb") { }

    NOTE: installing the EntityFramework NuGet package into this project will append
    an <entityFramework> section and a configSections entry here. That is expected -
    leave it in place.
  -->
  <connectionStrings>
    <add name="CustomerOrderDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CustomerOrderDb;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>